# Postgres connection string (Neon, Vercel Postgres/Neon integration, or any Postgres host)
# Get this from: Vercel dashboard -> Storage -> create/select a Postgres (Neon) database -> .env.local tab
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob storage token
# Get this from: Vercel dashboard -> Storage -> create/select a Blob store -> .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# stuff