# Postgres connection string for shiryu's site (Neon, Vercel Postgres/Neon integration, or any Postgres host)
# Get this from: Vercel dashboard -> Storage/Marketplace -> your Neon database -> .env.local tab
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Separate Postgres connection string for allchemi's site — a SEPARATE Neon database,
# fully isolated from shiryu's data. Same setup process, just a second database instance.
ALLCHEMI_POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob storage token (shared between both sites — Blob paths don't collide since
# each upload gets a unique filename)
# Get this from: Vercel dashboard -> Storage -> create/select a Blob store -> .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
